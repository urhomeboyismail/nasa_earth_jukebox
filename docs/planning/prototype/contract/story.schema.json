{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "story.schema.json",
  "title": "Story file (T1 contract)",
  "description": "One story = one data series, played as sound. Draft until frozen at hour 6 (later changes need agreement from the sound and frontend owners). Shape rules live here; cross-field rules (gaps match rests, thresholds, baseline mean) live in validate_story.py. Rule: a rest step has value null. A value is never invented to fill a gap.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "meta", "encoding", "steps", "gaps", "key_moments", "text"],
  "properties": {
    "schema_version": { "const": "1.0.0-draft" },

    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["story_id", "title", "is_fixture", "series_label", "sources", "eic_visualization"],
      "properties": {
        "story_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,40}$" },
        "title": { "type": "string", "minLength": 3 },
        "is_fixture": { "type": "boolean", "description": "true = invented values for building. Never shipped as a real story." },
        "series_label": { "type": "string", "minLength": 2, "description": "What the number means, in plain words (for example 'ice seen')." },
        "region": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "bbox", "grid"],
          "description": "Optional. The map area each value summarises, so facts can state it.",
          "properties": {
            "name": { "type": "string", "minLength": 2 },
            "bbox": {
              "type": "object",
              "additionalProperties": false,
              "required": ["west", "south", "east", "north"],
              "properties": { "west": { "type": "number" }, "south": { "type": "number" }, "east": { "type": "number" }, "north": { "type": "number" } }
            },
            "grid": {
              "type": "object",
              "additionalProperties": false,
              "required": ["width", "height"],
              "properties": { "width": { "type": "integer", "minimum": 1 }, "height": { "type": "integer", "minimum": 1 } }
            }
          }
        },
        "unit": { "type": "string", "minLength": 1 },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name", "url", "credit"],
            "properties": {
              "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,24}$" },
              "name": { "type": "string", "minLength": 2 },
              "url": { "type": "string", "pattern": "^https://" },
              "credit": { "type": "string", "minLength": 2 }
            }
          }
        },
        "eic_visualization": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "text"],
          "properties": {
            "status": { "enum": ["matched", "none_verified"] },
            "title": { "type": "string" },
            "url": { "type": "string", "pattern": "^https://" },
            "text": { "type": "string", "minLength": 10, "description": "Shown to users. For none_verified it must say plainly that no matching EIC visualization was verified." }
          },
          "if": { "properties": { "status": { "const": "matched" } } },
          "then": { "required": ["title", "url"] }
        }
      }
    },

    "encoding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain_min", "domain_max", "colour_key", "side_a", "side_b"],
      "properties": {
        "domain_min": { "type": "number" },
        "domain_max": { "type": "number" },
        "colour_key": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_id", "bin_width"],
          "properties": {
            "source_id": { "type": "string" },
            "bin_width": { "type": "number", "exclusiveMinimum": 0, "description": "Width of one colour-key bin in the series unit. Side B states this coarseness; it never says 'exact'." }
          }
        },
        "side_a": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rounding_statement"],
          "properties": {
            "rounding_statement": { "type": "string", "minLength": 10, "description": "Plain words: pitches snap to a scale, so values are rounded to about [step]." }
          }
        },
        "side_b": {
          "type": "object",
          "additionalProperties": false,
          "required": ["coarseness_statement"],
          "properties": {
            "coarseness_statement": { "type": "string", "minLength": 10 }
          }
        }
      }
    },

    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step_indices", "value", "statement"],
      "description": "Optional. Present only if a reference tone makes sense. value must equal the mean of the listed steps (checked by the validator).",
      "properties": {
        "step_indices": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 0 }, "uniqueItems": true },
        "value": { "type": "number" },
        "statement": { "type": "string", "minLength": 10 }
      }
    },

    "steps": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["index", "label", "state", "value", "coverage_pct"],
        "properties": {
          "index": { "type": "integer", "minimum": 0 },
          "label": { "type": "string", "minLength": 1 },
          "state": { "enum": ["data", "low_confidence", "rest"] },
          "value": { "type": ["number", "null"] },
          "coverage_pct": { "type": "number", "minimum": 0, "maximum": 100 },
          "rest_reason": { "enum": ["no_frame", "low_coverage"] },
          "source_id": { "type": "string" },
          "frame": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+\\.png$", "description": "Optional. Path of the map image for this step, relative to the stories folder. Absent for a rest with no frame." },
          "marker": {
            "type": "object",
            "additionalProperties": false,
            "required": ["x", "y"],
            "description": "Optional. Where on the frame the value was read, as 0 to 1 fractions. Sighted view only.",
            "properties": {
              "x": { "type": "number", "minimum": 0, "maximum": 1 },
              "y": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        },
        "allOf": [
          {
            "if": { "properties": { "state": { "const": "rest" } }, "required": ["state"] },
            "then": {
              "required": ["rest_reason"],
              "properties": { "value": { "type": "null" } }
            },
            "else": {
              "required": ["source_id"],
              "properties": { "value": { "type": "number" } },
              "not": { "required": ["rest_reason"] }
            }
          }
        ]
      }
    },

    "gaps": {
      "type": "array",
      "description": "One entry per run of consecutive rest steps with the same reason. The validator checks these match the steps exactly.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["start_index", "end_index", "reason", "message"],
        "properties": {
          "start_index": { "type": "integer", "minimum": 0 },
          "end_index": { "type": "integer", "minimum": 0 },
          "reason": { "enum": ["no_frame", "low_coverage"] },
          "message": { "type": "string", "minLength": 10, "description": "The one text shown at the end of the run. For no_frame it says no data, not zero." }
        }
      }
    },

    "key_moments": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step_index", "title", "message"],
        "properties": {
          "step_index": { "type": "integer", "minimum": 0 },
          "title": { "type": "string", "minLength": 3 },
          "message": { "type": "string", "minLength": 10 },
          "fact_ids": { "type": "array", "items": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,32}$" } }
        }
      }
    },

    "text": {
      "type": "object",
      "additionalProperties": false,
      "required": ["orientation", "alt_short", "alt_long", "legend"],
      "properties": {
        "orientation": { "type": "string", "minLength": 20 },
        "alt_short": { "type": "string", "minLength": 5, "maxLength": 140 },
        "alt_long": { "type": "string", "minLength": 20 },
        "legend": { "type": "string", "minLength": 10 }
      }
    }
  }
}
