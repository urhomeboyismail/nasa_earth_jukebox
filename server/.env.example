# Copy to server/.env and fill in. Never commit the real .env.
GEMINI_API_KEY=
# GEMINI_LIVE_MODEL=gemini-3.8-live
# GEMINI_API_VERSION=v1beta
# Google ADK agent. Off by default: nothing calls the model while AGENT_ENABLED is false.
# AGENT_ENABLED=false
# Model id the ADK agent uses (confirmed with a real key in G07).
# AGENT_MODEL=gemini-2.5-flash
# Seconds one agent request may take before it gives up.
# AGENT_TIMEOUT_SECONDS=2.5
# Agent requests allowed per minute, shared by the whole server.
# AGENT_MAX_REQUESTS_PER_MINUTE=5
# Ask requests allowed a minute for one visitor (by address), inside the whole-server limit above.
# AGENT_MAX_REQUESTS_PER_MINUTE_PER_VISITOR=3
# Which engine runs the voice guide: bridge (the old Gemini Live bridge) or adk.
# ASSISTANT_ENGINE=bridge
# The model for the Jukebox orchestrator's four agents (app/agent/orchestrator.py). Not a Live model.
# ORCHESTRATOR_MODEL=gemini-3.5-flash-lite
# Its route, POST /api/v1/jukebox/generate. Off by default: every run is billed (up to about 15 model calls).
# JUKEBOX_ENABLED=false
# Runs allowed a minute, for the whole server, and the seconds one run may take.
# JUKEBOX_RUNS_PER_MINUTE=4
# Runs allowed a minute for one visitor (by address), inside the whole-server limit above.
# JUKEBOX_RUNS_PER_MINUTE_PER_VISITOR=2
# JUKEBOX_TIMEOUT_SECONDS=120
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# STUDY_DB_PATH=study.db
# Required to download the listening-test CSV (header X-Team-Token). Use a long random value.
# STUDY_EXPORT_TOKEN=
# Most listening-test sessions the database holds, so nobody can fill the disk. Further sessions get HTTP 503.
# STUDY_MAX_SESSIONS=500
