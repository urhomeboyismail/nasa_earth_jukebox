# Copy to server/.env and fill in. Never commit the real .env.
GEMINI_API_KEY=
# GEMINI_LIVE_MODEL=gemini-3.8-live
# GEMINI_API_VERSION=v1beta
# Google ADK agent. Off by default: nothing calls the model while AGENT_ENABLED is false.
# AGENT_ENABLED=false
# Model id the ADK agent uses (confirmed with a real key in G07).
# AGENT_MODEL=gemini-2.5-flash
# Seconds one agent request may take before it gives up.
# AGENT_TIMEOUT_SECONDS=2.5
# Agent requests allowed per minute, shared by the whole server.
# AGENT_MAX_REQUESTS_PER_MINUTE=5
# Which engine runs the voice guide: bridge (the old Gemini Live bridge) or adk.
# ASSISTANT_ENGINE=bridge
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# STUDY_DB_PATH=study.db
# Required to download the listening-test CSV (header X-Team-Token). Use a long random value.
# STUDY_EXPORT_TOKEN=
