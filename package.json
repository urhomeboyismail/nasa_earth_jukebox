{
  "name": "moon-heist",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check-data": "vitest run src/data src/analysis/synthetic.test.ts",
    "check-bundle": "node scripts/check-bundle.mjs",
    "new-translation": ".venv/bin/python -I scripts/consume.py new",
    "parse-nasa": ".venv/bin/python -I scripts/consume.py parse",
    "clean-consumption": ".venv/bin/python -I scripts/consume.py clean",
    "view": "vite --host 127.0.0.1 --port 5180 --strictPort",
    "check": "npm run lint && npm test && npm run check-data && .venv/bin/python -I -m pytest scripts/tests -q"
  },
  "dependencies": {
    "@radix-ui/react-slider": "^1.6.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.184.0",
    "tonal": "^6.5.1",
    "tone": "^15.1.22",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "oxlint": "^1.89.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "vitest-axe": "^0.1.0"
  }
}
