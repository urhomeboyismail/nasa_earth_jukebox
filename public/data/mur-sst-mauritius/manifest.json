  "story": [
    {
      "id": "a-warm-start",
      "title": "A warm start",
      "fromFrame": "2023-01-23",
      "toFrame": "2023-02-22",
      "text": "From late January to late February the sea around Mauritius is about 27 to 28 °C, warm on our scale. These numbers are read from the colours of NASA's maps, so they are about, not exact. One date, 2 February, has no data at all, so the app plays a hiss there, never a low note: missing data is not cold."
    },
    {
      "id": "the-warmest-weeks",
      "title": "The warmest weeks",
      "fromFrame": "2023-03-04",
      "toFrame": "2023-04-23",
      "text": "From early March to late April the water is at its warmest, about 28 °C or a little more, hot on our scale. The highest map in this set is 3 April, at about 28.6 °C. The notes sit high."
    },
    {
      "id": "the-sea-cools",
      "title": "The sea cools",
      "fromFrame": "2023-05-03",
      "toFrame": "2023-07-12",
      "text": "From May the water slowly cools. It is about 27.7 °C on 3 May, about 26.3 °C on 12 June and about 25 °C by 12 July. The notes step down from warm to mild to cool."
    },
    {
      "id": "the-coolest-water",
      "title": "The coolest water",
      "fromFrame": "2023-07-22",
      "toFrame": "2023-08-01",
      "text": "By late July and on 1 August the sea is about 24.7 °C, cold on our scale and nearly 4 °C cooler than on 3 April. The notes are as low as they get in this set."
    }
  ]
